rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Multiplayer Match Rooms Collection
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isValidId(roomId);
    }
  }
}

